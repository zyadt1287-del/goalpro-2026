<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><title>تفاصيل المباراة</title>
<style>:root{--orange:#FF6A00;--dark:#0A0F1A;--card:#111827}body{background:var(--dark);color:#fff;font-family:Arial;text-align:center;padding:20px}</style></head><body>
<h2 id="title">تحميل...</h2><div id="details"></div>
<script>
const API_KEY = "dda3b1feca8c5f85074600f98d2ff963";
const id = new URLSearchParams(location.search).get('id');
fetch(`https://v3.football.api-sports.io/fixtures?id=${id}`,{headers:{"x-apisports-key":API_KEY}})
.then(r=>r.json()).then(d=>{
  let m=d.response[0];
  document.getElementById('title').innerText = `${m.teams.home.name} vs ${m.teams.away.name}`;
  document.getElementById('details').innerHTML = `<h1>${m.goals.home} - ${m.goals.away}</h1><p>الدقيقة: ${m.fixture.status.elapsed}'</p>`;
});
</script></body></html>
