<!DOCTYPE html><html lang="ar" dir="rtl"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GOALPRO ORANGE - بث مباشر ونتائج لحظية</title>
<style>
:root{--orange:#FF6A00;--dark:#0A0F1A;--card:#111827;--gold:#FFD700}
*{box-sizing:border-box;font-family:'Segoe UI',Arial}
body{background:var(--dark);color:#fff;margin:0}
header{position:relative;padding:20px;text-align:center;background:#000;border-bottom:2px solid var(--orange)}
#logo:hover #ball{filter:url(#glow)}
#logo:hover text{animation:shine 1s}
@keyframes shine{0%{opacity:0.5} 50%{opacity:1;filter:url(#glow)} 100%{opacity:1}}
.nav a{color:var(--gold);margin:0 15px;text-decoration:none;font-weight:600}
.container{max-width:1200px;margin:auto;padding:20px}
.card{background:var(--card);padding:15px;border-radius:12px;margin:10px 0;cursor:pointer}
.card:hover{background:#1F2937}
.match{display:flex;justify-content:space-between;align-items:center}
.score{font-size:24px;font-weight:800;color:var(--orange)}
#connectWallet{background:#3375BB;position:absolute;left:20px;top:15px;color:#fff;border:none;padding:8px 16px;border-radius:20px;font-weight:600;cursor:pointer}
#walletLink{position:absolute;left:170px;top:20px;color:var(--gold);text-decoration:none}
</style></head><body>

<header>
<a href="index.html">
<svg id="logo" width="220" height="45" viewBox="0 0 220 45"><defs>
<linearGradient id="orangeGrad"><stop offset="0%" stop-color="#FF6A00"/><stop offset="100%" stop-color="#FFD700"/></linearGradient>
<filter id="glow"><feGaussianBlur stdDeviation="2.5"/></filter></defs>
<g id="ball"><circle cx="22" cy="22.5" r="18" fill="url(#orangeGrad)"/>
<animateTransform attributeName="transform" type="rotate" from="0 22 22.5" to="360 22 22.5" dur="3s" repeatCount="indefinite"/></g>
<text x="50" y="28" font-size="22" font-weight="800" fill="url(#orangeGrad)">GOALPRO</text>
<text x="50" y="40" font-size="12" font-weight="600" fill="#FFD700">ORANGE</text></svg></a>

<button id="connectWallet" onclick="connectWallet()">🔗 ربط المحفظة</button>
<a id="walletLink" href="wallet.html">💰 المحفظة</a>
</header>

<div class="nav" style="text-align:center;padding:15px;background:#111">
<a href="index.html">الرئيسية</a>
<a href="schedule.html">جدول اليوم</a>
<a href="league.html">الترتيب</a>
<a href="news.html">الاخبار</a>
</div>

<div class="container">
<h2>المباريات المباشرة 🔴</h2>
<div id="liveMatches">جاري التحميل...</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/web3@1.8.2/dist/web3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@walletconnect/web3-provider@1.8.0/dist/umd/index.min.js"></script>
<script>
const API_KEY = "dda3b1feca8c5f85074600f98d2ff963";

async function loadLive(){
  let res = await fetch("https://v3.football.api-sports.io/fixtures?live=all",{headers:{"x-apisports-key":API_KEY}});
  let data = await res.json();
  let html = "";
  data.response.slice(0,5).forEach(m=>{
    html += `<div class="card match" onclick="location='match.html?id=${m.fixture.id}'">
      <div><img src="${m.teams.home.logo}" width="25"> ${m.teams.home.name} vs <img src="${m.teams.away.logo}" width="25"> ${m.teams.away.name}</div>
      <div class="score">${m.goals.home} - ${m.goals.away}</div>
      <div>${m.fixture.status.elapsed}'</div>
    </div>`;
  });
  document.getElementById('liveMatches').innerHTML = html || "لا توجد مباريات الان";
}
loadLive(); setInterval(loadLive, 10000);

// كود ربط Trust Wallet
async function connectWallet(){
  const provider = new WalletConnectProvider.default({rpc: {56: "https://bsc-dataseed.binance.org/"}});
  await provider.enable();
  const web3 = new Web3(provider);
  const accounts = await web3.eth.getAccounts();
  document.getElementById('connectWallet').innerText = '✅ ' + accounts[0].slice(0,6) + '...' + accounts[0].slice(-4);
  localStorage.setItem('wallet', accounts[0]);
}
</script></body></html>
