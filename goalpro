<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>GOALPRO ORANGE</title><style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial}
body{background:#050811;color:#fff;padding-bottom:180px}
header{background:linear-gradient(90deg,#FF6A00,#FF8C00);padding:15px;text-align:center;border-bottom:4px solid #FFD700;position:sticky;top:0;z-index:10}
header b{font-size:26px;color:#FFD700;letter-spacing:2px}
h2{text-align:center;margin:15px 0 5px 0;color:#FF6A00;font-size:22px}
h3{text-align:center;margin:0 0 15px 0;color:#aaa;font-weight:400}
.grid{display:grid;grid-template-columns:1fr;gap:15px;padding:15px;max-width:1200px;margin:auto}
.card{background:#0B1120;border:2px solid #FF6A00;border-radius:12px;padding:15px}
.search-box{width:100%;padding:12px;border-radius:8px;border:2px solid #FF6A00;background:#000;color:#fff;margin-bottom:15px;font-size:16px;outline:none}
.tournament{padding:12px;border-bottom:1px solid #2a2a2a;cursor:pointer;transition:0.2s;border-radius:6px}
.tournament:hover{background:#1a1a1a;border-left:4px solid #FF6A00;padding-left:8px}
.bottom{position:fixed;bottom:0;left:0;width:100%;height:170px;background:#FF6A00;border-top:4px solid #FFD700;overflow:auto;padding:10px;color:#000}
.news{padding:15px;background:#0B1120;margin:15px;border-radius:12px;border:2px solid #FF6A00}
.news h4{color:#FF6A00;margin-bottom:10px}
.btn{background:#FFD700;color:#000;border:none;padding:8px 12px;border-radius:6px;font-weight:bold;cursor:pointer;margin:5px 3px;font-size:12px}
.btn-stars{background:#FF6A00;color:#fff}
.match-box{background:#111;padding:10px;margin:10px 0;border-radius:8px;border:1px solid #333;color:#fff}
.match-box b{color:#FF6A00}
</style></head><body>

<header><b>GOALPRO ORANGE</b></header>

<h2>🏆 200+ بطولة عالمية</h2>
<h3>2026-2034</h3>

<div class="grid">
  <div class="card">
    <input type="text" id="searchInput" onkeyup="searchTournament()" placeholder="ابحث عن بطولة..." class="search-box">
    <div id="tournamentsList"></div>
  </div>
</div>

<div class="news">
  <h4>📰 اخر الاخبار</h4>
  <div id="newsList">جاري جلب الاخبار...</div>
</div>

<div class="bottom" id="live">جاري جلب المباريات المباشرة...</div>

<script>
const API_KEY = "dda3b1feca8c5f85074600f98d2ff963";

const tournaments = [
  {name:"دوري ابطال اوروبا", info:"UCL • Europe", id:2},
  {name:"الدوري الانجليزي", info:"Premier League • 20 فريق", id:39},
  {name:"الدوري الاسباني", info:"La Liga • 20 فريق", id:140},
  {name:"الدوري الالماني", info:"Bundesliga • 18 فريق", id:78},
  {name:"الدوري الايطالي", info:"Serie A • 20 فريق", id:135},
  {name:"كاس العالم 2026", info:"FIFA • 48 فريق", id:1},
  {name:"الدوري السعودي", info:"Saudi Pro League • 18 فريق", id:307},
  {name:"الدوري المصري", info:"Egyptian Premier League", id:233},
  {name:"الدوري المغربي", info:"Botola Pro", id:277},
  {name:"الدوري الجزائري", info:"Ligue 1", id:168},
  {name:"الدوري التونسي", info:"Ligue 1", id:256},
  {name:"دوري ابطال اسيا", info:"AFC Champions League", id:2},
  {name:"كاس الامم الافريقية", id:4},
  {name:"الدوري الامريكي", info:"MLS • 30 فريق", id:253},
  {name:"الدوري الفرنسي", info:"Ligue 1 • 20 فريق", id:61}
];
for(let i=1; i<=186; i++){
  let teams = 16 + (i % 10);
  tournaments.push({name:`دوري ${i} عالمي`, info:`${teams} فريق`});
}

let html = "";
tournaments.forEach(t=>{
  html += `<div class="tournament">${t.name}<br><small style="color:#aaa">${t.info}</small></div>`;
});
document.getElementById('tournamentsList').innerHTML = html;

function searchTournament() {
  let input = document.getElementById('searchInput').value.toLowerCase();
  let items = document.getElementsByClassName('tournament');
  for (let i = 0; i < items.length; i++) {
    let txt = items[i].innerText.toLowerCase();
    items[i].style.display = txt.includes(input)? "" : "none";
  }
}

async function getLive(){
  try{
    let res = await fetch("https://v3.football.api-sports.io/fixtures?live=all",{headers:{"x-apisports-key":API_KEY}});
    let data = await res.json();
    let html = "<b style='color:#000'>LIVE NOW 🔴</b><br>";
    if(data.response.length === 0) html += "لا توجد مباريات مباشرة";
    data.response.slice(0,5).forEach(m=>{
      html+=`<div class="match-box">
      <b>${m.league.name}</b><br>
      ${m.teams.home.name} ${m.goals.home}-${m.goals.away} ${m.teams.away.name} <b>د${m.fixture.status.elapsed}'</b>
      <br>
      <button class="btn" onclick="alert('شكرا لدعمك ❤️ التبرع اختياري')">دعم البث</button>
      <button class="btn btn-stars" onclick="alert('تم ارسال ${Math.floor(Math.random()*50)+1} نجمة ⭐ شكرا لك')">ارسال نجوم ⭐</button>
      </div>`;
    });
    document.getElementById('live').innerHTML = html;
  }catch(e){document.getElementById('live').innerHTML = "خطأ في جلب المباريات"}
}

function getNews(){
  document.getElementById('newsList').innerHTML =
  "1- مان سيتي يتصدر الدوري الانجليزي <br> 2- الهلال يفوز 4-0 في الدوري السعودي <br> 3- الاهلي يستعد لدوري الابطال";
}

getLive(); getNews();
setInterval(getLive,60000);
</script>
</body></html>
