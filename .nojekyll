<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GoalPro ULTIMATE v12</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{ --primary:#0047AB; --accent:#FFB800; --bg:#050811; --card:#0B1120; --text:#F8FAFC; --muted:#94A3B8; --stars:#FFD700; --donate:#10B981;}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
body{background:var(--bg); color:var(--text);}
header{background:linear-gradient(90deg, var(--primary) 0%, #000 100%); padding:12px 0; border-bottom:3px solid var(--accent); position:sticky; top:0; z-index:999;}
.wrap{max-width:1600px;margin:auto;padding:0 15px;display:flex;align-items:center;justify-content:space-between; flex-wrap:wrap; gap:10px;}
.logo{font-size:26px;font-weight:900; color:#fff; display:flex; align-items:center; gap:8px;}
.logo img{width:35px; height:35px;}
nav a{color:#fff; text-decoration:none; margin:0 8px; font-weight:700;}
.btn{padding:8px 14px; border-radius:20px; font-weight:900; border:0; cursor:pointer;}
.btn-stars{background:var(--stars); color:#000;}
.btn-donate{background:var(--donate); color:#fff;}
select{background:var(--card); color:var(--text); border:1px solid var(--accent); padding:6px 10px; border-radius:6px;}
.container{max-width:1600px;margin:15px auto;padding:0 15px;display:grid;grid-template-columns:2fr 1fr; gap:15px;}
.card{background:var(--card); border-radius:10px; padding:15px; border:1px solid #1E293B;}
.card h3{border-left:4px solid var(--accent); padding-left:10px; margin-bottom:12px; font-size:18px;}
.tours{display:grid; grid-template-columns:repeat(2,1fr); gap:12px;}
.tour{background:#0B1120; padding:12px; border-radius:8px; border:1px solid #1E293B; cursor:pointer; transition:0.3s;}
.tour:hover{border-color:var(--accent);}
.tour-top{display:flex; align-items:center; gap:10px; margin-bottom:8px;}
.tour img{width:40px; height:40px;}
.tour h4{font-size:15px; color:var(--accent);}
.tour-details{font-size:11px; color:var(--muted); line-height:1.6;}
.tour-details span{color:var(--text); font-weight:700;}
.formation{display:grid; grid-template-columns:repeat(5,1fr); gap:6px; background:#000; padding:15px; border-radius:8px; margin-top:10px;}
.player{width:45px; height:45px; background:var(--primary); border-radius:50%; margin:auto; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:900; border:2px solid var(--accent);}
.profile{display:flex; align-items:center; gap:10px; background:#0B1120; padding:10px; border-radius:8px; margin-bottom:10px;}
.profile img{width:50px; height:50px; border-radius:50%;}
.popup{display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;}
.box{background:var(--card); padding:25px; border-radius:15px; border:2px solid var(--accent); max-width:400px; text-align:center;}
input{width:100%; padding:10px; margin:8px 0; background:#000; border:1px solid #333; color:#fff; border-radius:6px;}
[dir="rtl"].card h3{border-left:0; border-right:4px solid var(--accent); padding-left:0; padding-right:10px;}
</style>
</head>
<body>
<header>
<div class="wrap">
<div class="logo"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png">GOALPRO</div>
<nav><a href="#">Home</a><a href="#">Live</a><a href="#">Tables</a></nav>
<div style="display:flex; gap:8px;">
<button class="btn btn-stars" onclick="document.getElementById('s').style.display='flex'">⭐ <span data-key="stars">Stars</span></button>
<button class="btn btn-donate" onclick="document.getElementById('d').style.display='flex'">💰 <span data-key="donate">Donate</span></button>
<select id="lang" onchange="changeLang()">
<option value="en">English</option><option value="ar">العربية</option><option value="ru">Русский</option><option value="zh">中文</option><option value="hi">हिन्दी</option>
</select>
</div>
</div>
</header>
<div class="container">
<div>
<div class="card">
<h3 data-key="tour">🏆 All Tournaments 2026-2034</h3>
<div class="tours">
<!-- 1 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>UEFA Champions League</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Sep 2026 - Jun 2027<br>
<span data-key="teams">Teams:</span> 36 Teams<br>
<span data-key="prize">Prize:</span> $2.4 Billion<br>
<span data-key="desc">Biggest club tournament in Europe</span>
</div>
</div>
<!-- 2 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>Premier League</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Aug 2026 - May 2027<br>
<span data-key="teams">Teams:</span> 20 Teams<br>
<span data-key="prize">Prize:</span> $4.5 Billion TV<br>
<span data-key="desc">Most watched league in the world</span>
</div>
</div>
<!-- 3 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>FIFA World Cup 2026</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Jun - Jul 2026<br>
<span data-key="teams">Teams:</span> 48 Teams<br>
<span data-key="prize">Prize:</span> $440 Million<br>
<span data-key="desc">USA, Canada, Mexico. Biggest ever WC</span>
</div>
</div>
<!-- 4 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>Saudi Pro League</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Aug 2026 - May 2027<br>
<span data-key="teams">Teams:</span> 18 Teams<br>
<span data-key="prize">Prize:</span> $500 Million<br>
<span data-key="desc">Ronaldo, Benzema, Neymar league</span>
</div>
</div>
<!-- 5 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>La Liga</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Aug 2026 - May 2027<br>
<span data-key="teams">Teams:</span> 20 Teams<br>
<span data-key="prize">Prize:</span> $2.1 Billion<br>
<span data-key="desc">Home of Real Madrid & Barcelona</span>
</div>
</div>
<!-- 6 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>Serie A</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Aug 2026 - May 2027<br>
<span data-key="teams">Teams:</span> 20 Teams<br>
<span data-key="prize">Prize:</span> $1.3 Billion<br>
<span data-key="desc">Italian football with history</span>
</div>
</div>
<!-- 7 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>Bundesliga</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Aug 2026 - May 2027<br>
<span data-key="teams">Teams:</span> 18 Teams<br>
<span data-key="prize">Prize:</span> $1.6 Billion<br>
<span data-key="desc">German efficiency & fan culture</span>
</div>
</div>
<!-- 8 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>Ligue 1</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Aug 2026 - May 2027<br>
<span data-key="teams">Teams:</span> 18 Teams<br>
<span data-key="prize">Prize:</span> $900 Million<br>
<span data-key="desc">PSG and French talents</span>
</div>
</div>
<!-- 9 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>AFC Asian Cup</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Jan 2027<br>
<span data-key="teams">Teams:</span> 24 Teams<br>
<span data-key="prize">Prize:</span> $14.8 Million<br>
<span data-key="desc">Biggest tournament in Asia</span>
</div>
</div>
<!-- 10 -->
<div class="tour">
<div class="tour-top"><img src="https://cdn-icons-png.flaticon.com/512/53/53496.png"><h4>Copa America</h4></div>
<div class="tour-details">
<span data-key="date">Date:</span> Jun - Jul 2027<br>
<span data-key="teams">Teams:</span> 16 Teams<br>
<span data-key="prize">Prize:</span> $72 Million<br>
<span data-key="desc">Messi vs Brazil. South America battle</span>
</div>
</div>
</div>
</div>
<div class="card">
<h3 data-key="form">⚽ Team Formation 4-3-3</h3>
<div class="formation">
<div></div><div class="player">ST</div><div></div><div class="player">ST</div><div></div>
<div class="player">LM</div><div class="player">CM</div><div class="player">CM</div><div class="player">CM</div><div class="player">RM</div>
<div class="player">LB</div><div class="player">CB</div><div class="player">CB</div><div class="player">CB</div><div class="player">RB</div>
<div></div><div></div><div class="player">GK</div><div></div><div></div>
</div>
</div>
</div>
<div>
<div class="card">
<h3 data-key="players">👤 Player Profiles</h3>
<div class="profile"><img src="https://randomuser.me/api/portraits/men/32.jpg"><div><b>Lionel Messi</b><br><span style="color:var(--muted); font-size:12px;">Argentina • 37 • Goals: 850</span></div></div>
<div class="profile"><img src="https://randomuser.me/api/portraits/men/45.jpg"><div><b>Cristiano Ronaldo</b><br><span style="color:var(--muted); font-size:12px;">Portugal • 39 • Goals: 900</span></div></div>
</div>
<div class="card">
<h3>💳 <span data-key="wallet">Wallet</span></h3>
<p style="color:var(--muted); font-size:13px;" data-key="walletd">Receive payments directly to USDT</p>
<input type="text" placeholder="TQn9YdTkv...Your USDT Address">
<button class="btn btn-donate" style="width:100%;" data-key="connect">Connect Wallet</button>
</div>
</div>
</div>
<div class="popup" id="s"><div class="box"><h2>⭐ Send Stars</h2><button onclick="document.getElementById('s').style.display='none'" class="btn" style="background:#333; color:#fff; width:100%; margin-top:10px;">Close</button></div></div>
<div class="popup" id="d"><div class="box"><h2>💰 Donate</h2><p>Send USDT to: TQn9YdTkv...YourWallet</p><button onclick="document.getElementById('d').style.display='none'" class="btn" style="background:#333; color:#fff; width:100%; margin-top:10px;">Close</button></div></div>
<footer style="text-align:center; padding:30px; color:var(--muted);">© 2026 GoalPro ULTIMATE</footer>
<script>
let lang="en";
const L={en:{stars:"Stars",donate:"Donate",tour:"All Tournaments 2026-2034",form:"Team Formation",players:"Player Profiles",wallet:"Wallet",walletd:"Receive payments directly to USDT",connect:"Connect Wallet",date:"Date:",teams:"Teams:",prize:"Prize:",desc:"Description:"},
ar:{stars:"نجوم",donate:"تبرع",tour:"كل البطولات 2026-2034",form:"تشكيلة الفريق",players:"ملفات اللاعبين",wallet:"المحفظة",walletd:"استلم المدفوعات مباشرة USDT",connect:"ربط المحفظة",date:"التاريخ:",teams:"الفرق:",prize:"الجائزة:",desc:"الوصف:"}};
function changeLang(){lang=document.getElementById("lang").value; document.querySelectorAll("[data-key]").forEach(el=>{if(L[lang][el.dataset.key]) el.innerText=L[lang][el.dataset.key];}); document.documentElement.dir=(lang=="ar")?"rtl":"ltr";}
</script>
</body>
</html>
